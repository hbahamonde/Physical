\subsection{Motivation}

\miniframesoff
\begin{frame}[c]{Good-looking Candidates do Better in Elections}
\begin{columns}
\begin{column}{.45\textwidth}
\begin{itemize}
  \item We know that better-looking candidates are more likely to win elections. 
  \item ``{\bf Voters vote beautiful}'' {\tiny\color{gray}(Efrain and Patterson, 1974)} because ``{\bf beautiful is good}'' {\tiny\color{gray}(Dion et al., 1972)}.
\end{itemize}
\end{column}
\begin{column}{.45\textwidth}
\includegraphics[width=\textwidth]{pic_4.png}
{\tiny ``What Are Good-Looking Candidates?'' (Stockemer and Praino, 2019)}
\end{column}
\end{columns}
\end{frame} 


%
\begin{frame}[c]{What About Wealthy-looking or Poor-looking Candidates?}
\begin{itemize}
  \item However, what happens when candidates \emph{look} \underline{poor/wealthy}.\\ \vspace{0.3cm}
   {\color{blue}\bf Does that affect their chances of getting elected?} \vspace{0.3cm}
  \item[\checkmark] This questions is relevant because it touches upon issues of social stratification and voting choices.
\end{itemize}
\end{frame} 



\subsection{Our paper}

\miniframeson
\begin{frame}[c]{Inequality Perspective: Social Stratification and Elections}
    %\item {\bf Motivate the problem}: It's clear that {\bf physically attractive candidates win elections more often}.

  \begin{itemize}
    \item {\bf Identify} that the literature \emph{only} looks at candidate attractiveness, which is just \emph{one} dimension of physical appearance.

    \item {\bf Beyond attractiveness} and explore the degree in which a candidate's {\bf social class} affects the number of votes received.

    %\item {\bf Inequality perspective}: study the effects of social stratification on electoral behavior.

    \item {\bf Empirics}: we exploit a novel data set of candidate physical appearances (2017 Finnish Municipal Elections).

    \item {\bf (\emph{Uncomfortable}) results}\pause: Finns systematically...
      \begin{enumerate}
        \item {\color{red}Vote less for {\bf working-class \emph{looking}} candidates, and \pause
        \item the fx's are stronger for {\bf female} candidates}. 
      \end{enumerate}
  \end{itemize}
\end{frame}



\section{Theory}

\subsection{Political Psychology}

\miniframeson
\begin{frame}[c]{Political Psychology: Heuristics}
    \begin{itemize}
      \item A candidate's {\bf physical appearance} is ``the most important'' {\color{gray}\tiny (Lau \& Redlawsk 2001)} and the ``most obvious and accessible'' {\color{gray}\tiny (Dion et al. 1972)} \emph{{\color{blue}heuristic}} available to voters {\color{gray}\tiny (Stockemer \& Praino 2017)}.\pause

      \item {\bf {\color{blue}Heuristics}} are cognitive devices that allow {\bf reasonable voting decision-making with \underline{minimal effort}} {\color{gray}\tiny (Lau \& Redlawsk 2001 and Tversky \& Kahneman 1973)}.\pause

      \item Thus, ``{\color{blue}voters vote beautiful}'' {\color{gray}\tiny(Efrain \& Patterson 1974)} because attractive candidates ``are more likely to be attributed the {\color{blue}qualities} associated with {\color{blue}successful} politicians'' {\color{gray}\tiny(Stockemer \& Praino 2019)}.

    \end{itemize}
\end{frame}



\subsection{Status Expectations Theory}

\miniframeson
\begin{frame}[c]{Status Expectations Theory}
    \begin{itemize}
      \item {\color{blue}Physical attractiveness} is considered a similar status characteristic as gender or occupation.
        %\begin{itemize}
        %  \item[$\checkmark$] For ex., attractive people are `{\color{blue}better}' or `{\color{blue}more capable}' {\tiny\color{gray}(Webster \& Driskell 1983)}.\pause
        %\end{itemize}

        \item[\checkmark] We extend this concept to cues of {\bf occupation} as a {\bf status} characteristic.

    \end{itemize}
\end{frame}


\section{Argument}

\subsection{Argument}


\miniframeson
\begin{frame}%<presentation:0>


\begin{alertblock}{Argument}
      We argue that information about candidates' {\bf \color{red}occupations} combined with information about candidates' {\bf \color{blue}physical appearance}, function as {\bf cues of status} that have an effect on {\bf voting choices} in low-information elections.
\end{alertblock}

\begin{exampleblock}{In simple...}
Candidates that {\color{blue}\bf look like} and actually {\color{red} \bf are} wealthy (poor) will do better (worse) in elections.
\end{exampleblock}



