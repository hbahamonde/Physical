\section{Empirics}

\subsection{Case}

\miniframeson
\begin{frame}[c]{Finland as a Hard Case}
  \begin{itemize}
    \item We follow a ``{\bf least-likely case design}'' {\color{gray}\tiny(Levy 2008).} Finland has been consistently considered as:
      \begin{itemize}
        \item[-] A `democratic' {\color{gray}\tiny (Polity-V)}.
        \item[-] An `economic egalitarian' {\color{gray}\tiny (Waltl 2022)}.
        \item[-] A `gender egalitarian.'
        \item[-] A `social-mobility prone' country {\color{gray}\tiny (Erola 2009)}.
        %\item[-] Having low-information Municipal Elections {\color{gray}\tiny(Berggren et al. 2010 and 2017)}.
      \end{itemize}
      \item Thus, it should be {\bf hard to find} a {\bf correlation} between {\color{blue}class-congruent use of status symbols} and {\bf voting}.
    \end{itemize}
\vspace{0.5cm}
...and yet, we \emph{do}.
\end{frame}

\miniframeson
\begin{frame}<presentation:0>[c]{Municipal Elections in Finland}
  \begin{itemize}
    \item {\bf Municipal Elections}: held every four years to elect councilors of the different municipalities {\color{gray}(N=293)}.
    \item {\bf D'Hondt}: candidates run in party lists. Seats are filled with lists of candidates proportionally.
    \item {\bf Municipalities}: provide daycare, health, education, water, waste management, among others.
  \end{itemize}
\end{frame}

\miniframesoff
\begin{frame}[c]{Campaigns: Plain, Simple and Fair}
\begin{columns}
\begin{column}{.45\textwidth}
\begin{itemize}
  \item {\bf Public posters}: 
    \begin{itemize}
      \item Show candidate face, party and occupation.
      \item Shown in city centers, bus stops, \emph{and} voting booths!
      \end{itemize}
  \item Municipalities \emph{must} provide the \emph{same} number of poster slots for all parties.
  %\item {\bf ``Low-information'' elections}: most voters get exposed to these posters only. {\color{gray}\tiny(Berggren et al. 2010 \& 2017).}
\end{itemize}
\end{column}
\begin{column}{.45\textwidth}
\includegraphics[width=\textwidth]{campaign2.png}
{\tiny Finnish Poster Displaying Candidates' Faces, Parties and Occupations}
\end{column}
\end{columns}
\end{frame} 

\subsection{Voting Data}


\miniframesoff
\begin{frame}[c]{2017 Municipal Elections: Candidate Data}
  \begin{itemize}
    \item {\bf Ministry of Justice}: candidate's picture, party, occupation, district and number of votes received.
    \item {\bf Sample}: randomly selected {\bf 1,500 candidate head shots}. {\tiny\color{gray}Universe 33,618; possible 10,000.}
    \item {\bf Occupation and social class}: {\color{blue}European Socio-economic Classification}, recoded each candidate's occupation (upper, middle and working class).
  \end{itemize}
\end{frame}

\subsection{Raters Data}

\miniframeson
\begin{frame}[c]{\hypertarget{pics:slide}Novel Raters Data}
  \begin{itemize}
    \item Collected data from 7,920 randomly selected Finnish-speaking Finns.
    \item {\bf Task}: evaluated a random sample of candidate photographs (N$\sim$50) according to four items.
    \item {\bf Items}: 
      \begin{enumerate}
        \item {\bf \scriptsize Occupation-Appearance congruence}. {\tiny{\color{gray}{\emph Does this person look like the profession he/she is declaring?}}}
        \item {\bf \scriptsize Attractiveness}.
        \item {\bf \scriptsize Masculinity}.
        \item {\bf \scriptsize Femininity}.
      \end{enumerate}
    %\item {\bf Avoiding recognition}: proprietary software designed to avoid assigning candidates running in the same rater's district.
     \vspace{1.5cm}
  \end{itemize}
   \hyperlink{table:items}{\beamergotobutton{show table with items}} \hyperlink{pics:distribution}{\beamergotobutton{show distributions}} \hyperlink{pics:balance}{\beamergotobutton{show balance plot}}

\end{frame}


\subsection{Statistical Analyses}


\miniframeson
\begin{frame}[c]{\hypertarget{reg:table:slide}{Functional Form and Model}}

 \begin{align*}
 Y_{i}=\text{Votes}_{i}\sim\;&\text{\texttt{Poisson}}\\
 \text{log(Votes}_{i})  = \;
 & \beta_{1}\text{{\only<2,12>{\color{red}}Occupation-Appearance Congruence}}_{i}\times\text{{\only<2,12>{\color{red}}Social Class}}_{i} + \\
 & \beta_{2}\text{{\only<3>{\color{red}}Age}}_{i} + \\
 & \gamma{1}\text{{\only<4>{\color{blue}}Party}}_{i} + \\
 & \gamma{2}\text{{\only<5>{\color{blue}}City}}_{i} + \\
 & \mathbf{\Theta}_{i}
 \end{align*}
 \begin{itemize}
  \item In  $\mathbf{\Theta}$ we {\bf also control for}: ${\only<6>{\color{red}}\text{Attractiveness}_{i}}$, ${\only<7>{\color{red}}\text{Masculinity}_{i}}$ and ${\only<8>{\color{red}}\text{Femininity}_{i}}$.
 \item {\only<9>{\color{red}}Full}, but also {\bf partition the data} ({\only<10>{\color{red}}male} \& {\only<11>{\color{red}}female}).
 \item We focus on the {\only<12>{\color{red}}{\bf marginal effects}}  of the {\only<12>{\color{red}}interaction term}.
 \\
 \hspace{10.7cm} \hyperlink{reg:table}{\beamergotobutton{show regression table}}
\end{itemize}
\end{frame}


\miniframesoff
\begin{frame}[plain]{\small Marginal Effects of the Interaction Term}
\centering\includegraphics[scale=0.3]{marginal_fx_plot.pdf}
\end{frame}

\miniframesoff
\begin{frame}[plain]{\small Marginal Effects of the Interaction Term}
\centering\includegraphics[scale=0.35]{marginal_fx_plot_male_fem.pdf}
\end{frame}

\miniframesoff
\begin{frame}[c]{Predicted Probabilities Table}
\begin{table}[]
\begin{tabular}{c|c|c|c|c|}
\textbf{Candidate's Gender} & \textbf{Status} & $\hat{\text{\bf Votes}}$ & \multicolumn{2}{c}{\textbf{95\% CI}}\\
\hline
\multirow{2}{*}{{\color{blue}Female}} & {\only<2>{\color{black!30!green}}Don't look like working class} &  {\only<2>{\color{black!30!green}}\Sexpr{round(ggpredict(m1.w, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[1,2]],0)}} & \Sexpr{round(ggpredict(m1.w, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[1,4]],0)} & \Sexpr{round(ggpredict(m1.w, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[1,5]],0)}\\
 &  {\only<3>{\color{red}}Look a lot like working class}  & {\only<3>{\color{red}}\Sexpr{round(ggpredict(m1.w, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[7,2]],0)}} & \Sexpr{round(ggpredict(m1.w, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[7,4]],0)} & \Sexpr{round(ggpredict(m1.w, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[7,5]],0)}\\
 \hline
\multirow{2}{*}{{\color{blue}Male}} & {\only<4>{\color{black!30!green}}Don't look like working class} & {\only<4>{\color{black!30!green}}\Sexpr{round(ggpredict(m1.m, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[1,2]],0)}} & \Sexpr{round(ggpredict(m1.m, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[1,4]],0)} & \Sexpr{round(ggpredict(m1.m, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[1,5]],0)}\\
 &  {\only<5>{\color{red}}Look a lot like working class}  & {\only<5>{\color{red}}\Sexpr{round(ggpredict(m1.m, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[8,2]],0)}} & \Sexpr{round(ggpredict(m1.m, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[8,4]],0)} & \Sexpr{round(ggpredict(m1.m, terms = "phys_occ_cong", condition = c(esec.r="Working"))[[8,5]],0)}\\
